# WhatsApp Cloud API
WA_TOKEN=your_whatsapp_access_token
WA_PHONE_ID=your_phone_number_id
WA_VERIFY_TOKEN=salonbot_verify_123

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
# POMEMBNO: uporabi SERVICE_ROLE (secret) kljuc, NE anon kljuca.
# Streznik je zaupanja vreden backend in mora obiti RLS, da bere vse salone/rezervacije.
# Anon kljuc z vklopljenim RLS vrne prazno (dashboard pokaze 0 salonov).
SUPABASE_KEY=your_supabase_service_role_key

# Server
PORT=3000
# Nastavi eksplicitno, da seje niso vezane na SUPABASE_KEY (sicer ob menjavi kljuca odjavi vse).
SESSION_SECRET=change_me_to_a_long_random_string
ADMIN_API_KEY=change_me
MASTER_ADMIN_PHONES=386xxxxxxxx

# Email fallback for booking notifications when a salon has no admin_phone
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=FlowTiq <noreply@yourdomain.com>

# Base URL for confirm/cancel links in admin emails (set to your Railway domain)
BASE_URL=https://your-railway-app.railway.app

# ─── Stripe (narocnine) ─────────────────────────────────────
# WEBHOOKA NI. Stanje narocnin beremo iz Stripa (src/stripe-sync.js): ob
# vrnitvi stranke s placila in vsako uro ob :20 iz urnika. Zato ni javnega
# endpointa in ni podpisnega kljuca za vzdrzevati, izgubljena dostava dogodka
# pa ni mogoca — vsak zagon uskladi stanje na novo.
#
# 1. Skrivni kljuc: Stripe Dashboard -> Developers -> API keys
#    Testni se zacne s sk_test_, zivi s sk_live_. To je edina skrivnost,
#    ki jo Stripe integracija potrebuje.
STRIPE_SECRET_KEY=sk_live_xxx
# 2. Produkte in cene ustvari skripta (imena in zneske vzame iz src/plans.js):
#      node tools/stripe-cene.js          (testni nacin)
#      node tools/stripe-cene.js --live   (zivi nacin)
#    Pregled stanja racuna: node tools/stripe-stanje.js
#
#    PRICE ID-JEV NI TREBA NIKAMOR PISATI. Vsaka cena dobi lookup_key
#    (aistart_month, aistart_year, ai_month, ai_year, premium_month,
#    premium_year) in strezniki jo poiscejo po njem. Ker Stripe isce znotraj
#    nacina, ki mu pripada API kljuc, se testne in zive cene razresijo same.
#
#    Zneski (src/plans.js je edini vir resnice; tam je tudi varovalka,
#    ki javi, ce letna cena ne ustreza 30 % popustu):
#      AI Start  89 EUR/mes    · letno   747,60 EUR (62,30/mes)   do 500 narocil
#      AI Pro    159,99 EUR/mes · letno 1.343,88 EUR (111,99/mes)  do 1.500 narocil
#      Premium   299 EUR/mes    · letno 2.511,60 EUR (209,30/mes)  do 10.000 narocil
#
# Neobvezno: rocna prevlada posamezne cene. Prazno = strezniki jo poiscejo sami.
# STRIPE_PRICE_AISTART=   / STRIPE_PRICE_AISTART_YEAR=
# STRIPE_PRICE_AI=        / STRIPE_PRICE_AI_YEAR=
# STRIPE_PRICE_PREMIUM=   / STRIPE_PRICE_PREMIUM_YEAR=
# Paketa Osnovni in Pro sta odstranjena iz kode; STRIPE_PRICE_STARTER / _PRO se ne bereta vec.

# Kam gredo obvestila o placilih, odpovedih in registracijah:
FLOWTIQ_OWNER_EMAIL=info@flowtiq.si

# AI natakar (paket AI)
# Ponudnik: 'openai', 'anthropic' (Claude) ali 'gemini' (Google)
AI_PROVIDER=gemini
ANTHROPIC_API_KEY=sk-ant-xxx
GEMINI_API_KEY=AIza-xxx
# Model: anthropic -> claude-haiku-4-5 · gemini -> gemini-2.5-flash · openai -> gpt-4o-mini / gpt-4o
AI_ORDER_MODEL=gemini-2.5-flash
# Fair-use meje so vezane na paket (AI Start 500, AI natakar 1500, Premium 10000).
# Spodnja vrednost je le rezerva za salone brez znanega paketa; per-lokal override = ai_monthly_limit.
AI_FAIR_USE_LIMIT=1500
